APP_NAME=Webots_AI_Robotics_Agent
APP_ENV=development
HOST=127.0.0.1
PORT=8000

# ---- Prompt interpretation: auto | ollama | groq | rules
# auto = Ollama if running (free, local) -> Groq if a key is set -> rule-based fallback
LLM_PROVIDER=auto
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ---- Webots (Windows)
WEBOTS_HOME=G:\InstallSoftWare\Webots
WEBOTS_EXECUTABLE=G:\InstallSoftWare\Webots\msys64\mingw64\bin\webots.exe
WEBOTS_PROJECT_DIR=G:\InstallSoftWare\Webots\projects
# Detected automatically from WEBOTS_HOME\resources\version.txt; this is only the fallback
WEBOTS_VERSION=R2025a
# webots (default, verified) | github | local
ASSET_URL_MODE=webots
# realtime | fast
WEBOTS_MODE=realtime
PIPELINE_RUN_MODE=realtime
KEEP_WEBOTS_OPEN=true
# Full path of the python.exe Webots should use for controllers (blank = PATH)
WEBOTS_PYTHON_COMMAND=

SIMULATION_TIMEOUT=300
MAX_ROBOT_COUNT=1
